<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>af173ac2-076d-417d-93de-ccc942908b57</UserSecretsId>
  </PropertyGroup>

  <!--
    NuGet paketleri: bu sandbox ortamında NuGet.org erişimi engellendiği için burada restore
    edilemedi (bkz. README.md). Localde `dotnet restore` en güncel uyumlu sürümleri çözecektir.
  -->
  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaneHesap.Application\TaneHesap.Application.csproj" />
    <ProjectReference Include="..\TaneHesap.Infrastructure\TaneHesap.Infrastructure.csproj" />
  </ItemGroup>

</Project>
